# ============================================================================
# AgentVille — environment configuration
# Copy this file to `.env.local` (recommended) or `.env`.
# The key is read by the Express API only and is NEVER sent to the browser.
# ============================================================================

# Google Gemini API key used for live citizen dialogue and the city gazette.
# Without a key the app still runs fully, using the built-in Arabic/English
# local templates.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Alternative variable name also accepted (e.g. for Google Cloud environments).
# GOOGLE_API_KEY=""

# Optional model override. Defaults to gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# Production server port (`npm start`). Vite dev always uses port 3000.
# PORT=3000

# AI Studio only: public URL of the deployed app.
# APP_URL="MY_APP_URL"
